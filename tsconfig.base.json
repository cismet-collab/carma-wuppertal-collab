{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "sourceMap": true,
    "moduleDetection": "force",
    "rootDir": ".",
    "baseUrl": ".",
    "types": [
      "vite/client",
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "@nx/react/typings/styled-jsx.d.ts"
    ],
    "paths": {
      "@carma-api": [
        "_carma_monorepo/libraries/carma-api/src/index.ts"
      ],
      "@carma-appframeworks/*": [
        "_carma_monorepo/libraries/appframeworks/*/src/index.ts"
      ],
      "@carma-commons/*": [
        "_carma_monorepo/libraries/commons/*/src/index.ts"
      ],
      "@carma-commons/resources/gcg2016": [
        "_carma_monorepo/libraries/commons/resources/src/lib/de/gcg2016.ts"
      ],
      "@carma-commons/ui/shadcn": [
        "_carma_monorepo/libraries/commons/ui/shadcn/src/index.ts"
      ],
      "@carma-units": [
        "_carma_monorepo/libraries/units/src/index.ts"
      ],
      "@carma-geo/*": [
        "_carma_monorepo/libraries/geo/*/src/index.ts"
      ],
      "@carma-mapping/annotations/builtin-tools/annotation-mode-text": [
        "_carma_monorepo/libraries/mapping/annotations/builtin-tools/src/lib/annotation-mode-text.ts"
      ],
      "@carma-mapping/*": [
        "_carma_monorepo/libraries/mapping/*/src/index.ts"
      ],
      "@carma-providers/*": [
        "_carma_monorepo/libraries/providers/*/src/index.ts"
      ],
      "@carma-cesium": [
        "_carma_monorepo/libraries/mapping/engines/cesium/api/src/index.ts"
      ]
    }
  }
}
